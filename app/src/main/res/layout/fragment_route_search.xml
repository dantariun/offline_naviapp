<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_setting_top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="80dp"
        android:layout_marginTop="32.5dp"
        android:paddingTop="12.5dp"
        android:paddingBottom="22.5dp"
        android:paddingHorizontal="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address Search"
            android:textColor="@color/gray_950"
            android:textSize="15dp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:src="@drawable/icon_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="80dp"
        android:layout_marginBottom="38dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/view_setting_top_area"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="37.25dp">
                
                <EditText
                    android:id="@+id/search_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/gray_500"
                    android:textColorHint="@color/gray_400"
                    android:textSize="10.5dp"
                    android:hint="Please enter your address"
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="18dp"
                    android:maxLines="1"
                    android:inputType="text"/>

                <ImageButton
                    android:id="@+id/btn_route_search"
                    android:layout_width="37.25dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="12.25dp"
                    android:src="@drawable/icon_searchpurple"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="#0FFFFFFF"
                android:orientation="vertical">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/route_list_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    tools:listitem="@layout/item_route" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/start_route_button"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        android:textAllCaps="false"
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:background="@drawable/bg_button_route_start"
                        android:text="Start guidance" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/cancel_button"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:layout_weight="1"
                        android:textSize="10dp"
                        android:textAllCaps="false"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:background="@drawable/bg_button_route_cancel"
                        android:text="Cancel"
                        android:textColor="@color/gray_600" />
                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

        <com.dantariun.sat_demo_map.util.map.TiltableMapView
            android:id="@+id/map_view_search"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_height="match_parent"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>