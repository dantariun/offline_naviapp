<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:layout_width="256dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_dialog_sat_contents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea">

        <ImageView
            android:id="@+id/image_warning_type"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerInside"
            tools:src="@drawable/icon_fire"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txt_warning_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/gray_950"
            android:text="Disaster reported nearby."
            app:layout_constraintTop_toBottomOf="@+id/image_warning_type"
            />

        <TextView
            android:id="@+id/txt_change_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/change_route"
            android:text="Change route?"
            app:layout_constraintTop_toBottomOf="@+id/txt_warning_description"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="25dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_change_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="@drawable/bg_dialog_sat_agree"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_stay"
            >

            <TextView
                android:id="@+id/txt_change_route_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:text="Change Route"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/text_add_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_add_yellow"
                android:textSize="8.5dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="3dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintTop_toBottomOf="@+id/txt_change_route_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/text_add_distance"
                tools:text="+ 23min"/>

            <TextView
                android:id="@+id/text_add_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_add_yellow"
                android:textSize="8.5dp"
                android:layout_marginTop="3dp"
                app:layout_constraintTop_toBottomOf="@+id/txt_change_route_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/text_add_time"
                tools:text="+ 300m"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btn_stay"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Stay on route"
            android:textSize="10dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/gray_500"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp"
            app:backgroundTint="@color/gray_200"
            android:background="@drawable/bg_dialog_sat_disagree"
            app:layout_constraintTop_toBottomOf="@+id/btn_change_route"
            />

        <TextView
            android:id="@+id/txt_dialog_sat_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="9dp"
            android:textColor="@color/gray_400"
            android:text="@string/underlined_switching"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/btn_stay"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>