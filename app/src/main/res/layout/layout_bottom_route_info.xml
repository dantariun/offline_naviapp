<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="45dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- 1. 경로 취소 섹션 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:text="경로\n취소"
        android:background="@drawable/bg_black_rounded_container"
        android:textColor="@android:color/white"
        android:textSize="12sp"/>


    <TextView
        android:id="@+id/text_speed"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_black_rounded_container"
        android:textColor="@color/white"
        android:text="0 km"/>

    <!-- 2. 도착 정보 섹션 -->
    <LinearLayout
        android:id="@+id/section_arrival_info"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_black_rounded_container"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrival_flag_white"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginStart="20dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/text_total_remaining_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7.0km"
                android:textColor="@android:color/white"
                android:textSize="14sp"/>
        </LinearLayout>


    </LinearLayout>

    <!-- 3. 다음 경로 섹션 -->
    <LinearLayout
        android:id="@+id/section_next_route"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_black_rounded_container"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_road_sign_white"/>

        <TextView
            android:id="@+id/text_next_road_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="200dp"
            android:text="양재대로"
            android:textColor="@android:color/white"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>
