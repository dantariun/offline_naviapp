<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_find"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:cardBackgroundColor="@color/gray_100">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_expandable_item"
            android:animateLayoutChanges="true">



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="47.5dp"
                android:paddingHorizontal="20dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/customSwitch"
                    android:layout_width="36dp"
                    android:layout_height="17.5dp"
                    android:checked="true"
                    android:thumb="@drawable/switch_thumb_custom"
                    app:track="@drawable/switch_track_custom"
                    app:useMaterialThemeColors="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="개인정보 약관동의"
                    android:textColor="@color/gray_950"
                    android:textSize="16sp"
                    android:textFontWeight="400"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/customSwitch"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_chevron"
                    android:layout_width="12.5dp"
                    android:layout_height="12.5dp"
                    android:src="@drawable/expandable_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/expandable_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_expandable_layout"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/content_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:textSize="9dp"
                    android:text="여기에 약관 내용이 표시됩니다. 개인정보 수집 및 이용에 동의하며..."
                    android:textColor="@color/gray_600"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>