<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomeActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>



    <LinearLayout
        android:id="@+id/statusView"
        android:layout_width="83.5dp"
        android:layout_height="22.5dp"
        android:clipToPadding="false"
        android:layout_margin="8dp"
        android:elevation="10dp"
        android:gravity="center_vertical|center"
        android:background="@drawable/bg_status_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/view_user_state"
            android:gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/text_status_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOD"
                android:layout_marginEnd="3dp"
                android:textColor="@color/gray_600"
                android:textSize="9dp"
                />

            <ImageView
                android:id="@+id/img_status_user"
                android:layout_width="11.5dp"
                android:layout_height="11.5dp"
                android:scaleType="centerInside"
                android:layout_marginEnd="6dp"
                android:src="@drawable/icon_good"/>
        </LinearLayout>

        <View
            android:layout_width=".25dp"
            android:layout_height="10dp"
            android:layout_marginEnd="5dp"
            android:background="@color/gray_200"/>

        <ImageButton
            android:id="@+id/btn_status_data"
            android:layout_width="22.5dp"
            android:layout_height="22.5dp"
            android:padding="5dp"
            android:scaleType="fitXY"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/data_lvl_4"/>


    </LinearLayout>


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
            android:id="@+id/app_bar_display"
            layout="@layout/layout_app_bar" />

    </com.google.android.material.appbar.AppBarLayout>

</androidx.constraintlayout.widget.ConstraintLayout>