<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_other"
        android:maxWidth="158dp"
        android:padding="8dp"
        android:textSize="8dp"
        android:textColor="@color/gray_950"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="상대방이 보낸 메시지입니다. 이 메시지도 길어질 수 있습니다." />

    <TextView
        android:id="@+id/timestamp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@android:color/darker_gray"
        android:textSize="6.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/message_text"
        app:layout_constraintStart_toEndOf="@+id/message_text"
        tools:text="PM 2:31" />

</androidx.constraintlayout.widget.ConstraintLayout>