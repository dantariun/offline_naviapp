<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:layout_width="256dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_dialog_sat_contents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomArea">

        <ImageView
            android:id="@+id/image_dialog_sat"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/image_sat"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:gravity="center"
            android:textColor="@color/gray_950"
            android:text="Would you like to use\nthe safety service?"
            app:layout_constraintTop_toBottomOf="@+id/image_dialog_sat"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="25dp"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <Button
            android:id="@+id/btn_sat_agree"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="Agree"
            android:textSize="10dp"
            android:textAllCaps="false"
            android:padding="0dp"
            android:background="@drawable/bg_dialog_sat_agree"
            app:backgroundTint="@color/purple_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_sat_disagree"
            />

        <Button
            android:id="@+id/btn_sat_disagree"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="@string/disagree"
            android:textSize="10dp"
            android:layout_marginTop="4dp"
            android:textAllCaps="false"
            android:padding="0dp"
            app:backgroundTint="@color/gray_200"
            android:background="@drawable/bg_dialog_sat_disagree"
            app:layout_constraintTop_toBottomOf="@+id/btn_sat_agree"
            />

        <TextView
            android:id="@+id/txt_dialog_sat_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="9dp"
            android:textColor="@color/gray_400"
            android:text="@string/underlined_second"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/btn_sat_disagree"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    

</androidx.constraintlayout.widget.ConstraintLayout>