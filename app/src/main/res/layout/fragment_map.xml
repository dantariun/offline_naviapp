<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/map_view_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_pop_up">

            <com.dantariun.sat_demo_map.util.map.TiltableMapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ImageView
                android:id="@+id/animatedGradientView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clickable="false"
                tools:visibility="visible"
                android:src="@drawable/gradient_green_overlay"/>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/left_navi_menu"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="40dp"
                android:paddingTop="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <include
                    android:id="@+id/top_next_turn_info"
                    layout="@layout/layout_top_next_turn"
                    android:layout_width="135dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.cardview.widget.CardView
                    android:layout_width="37.5dp"
                    android:layout_height="37.5dp"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="19dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:layout_constraintTop_toBottomOf="@+id/top_next_turn_info"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageButton
                        android:id="@+id/btn_ai_chat"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_command"
                        />

                </androidx.cardview.widget.CardView>



                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_sound"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="8dp"
                    android:visibility="gone"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="19dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toTopOf="@+id/card_find"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_sound_on"
                        />
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/card_find"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="19dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toTopOf="@+id/card_sos"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageButton
                        android:id="@+id/btn_find"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_search"
                        />
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/card_sos"
                    android:layout_width="55.5dp"
                    android:layout_height="24.5dp"
                    android:layout_margin="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="19dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageButton
                        android:id="@+id/btn_sos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_sos_call"
                        />
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/right_navi_menu"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="40dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/statusView"
                    android:visibility="invisible"
                    android:layout_width="83.5dp"
                    android:layout_height="22.5dp"
                    android:clipToPadding="false"
                    android:layout_margin="8dp"
                    android:elevation="10dp"
                    android:gravity="center_vertical|center"
                    android:background="@drawable/bg_status_white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/view_user_state"
                        android:gravity="center_vertical"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/text_status_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GOOD"
                            android:layout_marginEnd="3dp"
                            android:textColor="@color/gray_600"
                            android:textSize="9dp"
                            />

                        <ImageView
                            android:id="@+id/img_status_user"
                            android:layout_width="11.5dp"
                            android:layout_height="11.5dp"
                            android:scaleType="centerInside"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/icon_good"/>
                    </LinearLayout>

                    <View
                        android:layout_width=".25dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="5dp"
                        android:background="@color/gray_200"/>

                    <ImageButton
                        android:id="@+id/btn_status_data"
                        android:layout_width="22.5dp"
                        android:layout_height="22.5dp"
                        android:padding="5dp"
                        android:scaleType="fitXY"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/data_lvl_4"/>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="30dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_zoom_menu"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageButton
                        android:id="@+id/btn_zoom_in"
                        android:layout_width="30dp"
                        android:layout_height="32.5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/button_zoom_up_selector"
                        android:background="@android:color/transparent"/>

                    <ImageButton
                        android:id="@+id/btn_zoom_out"
                        android:layout_width="30dp"
                        android:layout_height="32.5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/button_zoom_down_selector"
                        android:background="@android:color/transparent"/>


                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusView">

                    <com.dantariun.sat_demo_map.util.etc.OutlineTextView
                        android:id="@+id/text_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_margin="10dp"
                        android:textSize="30dp"
                        android:shadowColor="@android:color/white"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10"
                        android:textStyle="bold"
                        tools:text="10"
                        android:textColor="@android:color/black"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/view_hidden"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toTopOf="@+id/card_setting"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_new_route"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginEnd="10dp"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="19dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageButton
                            android:id="@+id/btn_new_route"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ellipse"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="10dp"
                            android:clickable="false"
                            android:text="D"
                            />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_emergency"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="5dp"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="19dp"
                        app:layout_constraintBottom_toTopOf="@+id/card_setting"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:cardBackgroundColor="@android:color/transparent">

                        <ImageButton
                            android:id="@+id/btn_emergency"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/ellipse"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="10dp"
                            android:clickable="false"
                            android:text="E"
                            />
                    </androidx.cardview.widget.CardView>


                </LinearLayout>



                <androidx.cardview.widget.CardView
                    android:id="@+id/card_setting"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="10dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="19dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageButton
                        android:id="@+id/btn_setting"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_setting"
                        />
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_pop_up"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintEnd_toStartOf="@+id/map_view_container"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/view_pop_chat"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/view_chat_layout"
                    layout="@layout/layout_chat_view" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/view_pop_dialog"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include
                    android:id="@+id/view_dialog_sat"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/dialog_use_safety_question" />

                <include
                    android:id="@+id/view_dialog_sat_complete"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/dialog_use_safety_complete" />

                <include
                    android:id="@+id/view_dialog_route_change"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/dialog_change_route" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 좌측 버튼 메뉴 -->
    <include
        android:id="@+id/left_button_menu"
        layout="@layout/layout_left_buttons"
        android:layout_width="wrap_content"
        android:visibility="gone"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- 우측 상단 다음 경로 안내 포함 -->


    <include
        android:id="@+id/right_button_menu"
        android:visibility="gone"
        layout="@layout/layout_right_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />



    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>