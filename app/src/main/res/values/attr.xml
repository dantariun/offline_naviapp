<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="OutlineTextView">
        <attr name="outlineColor" format="reference|integer"/>
        <attr name="outlineWidth" format="reference|integer"/>
    </declare-styleable>
    <declare-styleable name="PulsingMotionView">
        <attr name="pmv_iconDrawable" format="reference" />
        <attr name="pmv_iconSize" format="dimension" />
        <attr name="pmv_waveColor" format="color" />
        <attr name="pmv_waveDuration" format="integer" />
    </declare-styleable>
    <declare-styleable name="DotElasticLoader">
        <attr name="del_dotColor" format="color" />
        <attr name="del_dotRadius" format="dimension" />
        <attr name="del_dotSpacing" format="dimension" />
        <attr name="del_animationDuration" format="integer" />
        <attr name="del_elasticScale" format="float" />
    </declare-styleable>
</resources>