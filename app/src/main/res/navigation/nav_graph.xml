<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.dantariun.sat_demo_map.ui.fragments.MapFragment"
        android:label="fragment_map"
        tools:layout="@layout/fragment_map" >
        <action
            android:id="@+id/action_mapFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_mapFragment_to_routeSearchFragment"
            app:destination="@id/routeSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/routeSearchFragment"
        android:name="com.dantariun.sat_demo_map.ui.fragments.RouteSearchFragment"
        android:label="fragment_route_search"
        tools:layout="@layout/fragment_route_search" />


    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.dantariun.sat_demo_map.ui.fragments.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>